# PostgreSQL: pooled runtime URL and direct migration URL for the same database.
# Supabase example: transaction pooler :6543 for DATABASE_URL; direct/session :5432 for DIRECT_URL.
DATABASE_URL="postgresql://USER:PASS@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASS@DIRECT_HOST:5432/postgres?sslmode=require"

# Auth.js
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3010"
NEXT_PUBLIC_APP_URL="http://localhost:3010"

# Explicit local/preview demo mode only. Never enable in production.
NEXT_PUBLIC_DEMO_MODE="false"

# Stripe Checkout + Connect. Leave placeholders for development; live booking stays disabled.
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_REPLACE_ME"

# Required for protected scheduled maintenance in production
CRON_SECRET="generate-an-independent-long-random-string"

# Transactional email (production only after domain verification)
RESEND_API_KEY="re_REPLACE_ME"
EMAIL_FROM="GatVuller <hallo@example.com>"
ADMIN_NOTIFICATION_EMAIL="beheer@example.com"

# Real legal identity and contact details before launch
NEXT_PUBLIC_COMPANY_LEGAL_NAME=""
NEXT_PUBLIC_COMPANY_VAT=""
NEXT_PUBLIC_COMPANY_ADDRESS=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_PRIVACY_EMAIL=""

PLATFORM_FEE_PERCENT="18"
