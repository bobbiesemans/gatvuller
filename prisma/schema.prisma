generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SALON_OWNER
  ADMIN
}

enum Category {
  KAPPER
  TANDARTS
  SCHOONHEID
  FYSIO
  AUTODIENST
  NAGELS
  MASSAGE
  ANDERS
}

enum SlotStatus {
  OPEN
  BOOKED
  CANCELLED
  EXPIRED
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String
  role         Role      @default(CUSTOMER)
  phone        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  salons       Salon[]
  bookings     Booking[]
}

model Salon {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  slug        String   @unique
  city        String
  category    Category
  description String
  address     String
  phone       String?
  imageUrl    String?
  rating      Float    @default(4.5)
  lat         Float    @default(50.85)
  lng         Float    @default(4.35)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slots       Slot[]

  @@index([city])
  @@index([category])
  @@index([lat, lng])
}

model Slot {
  id            String     @id @default(cuid())
  salonId       String
  salon         Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  startsAt      DateTime
  endsAt        DateTime
  originalPrice Int
  discountPrice Int
  spotsLeft     Int        @default(1)
  status        SlotStatus @default(OPEN)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  booking       Booking?

  @@index([startsAt, status])
  @@index([salonId])
}

model Booking {
  id               String        @id @default(cuid())
  slotId           String        @unique
  slot             Slot          @relation(fields: [slotId], references: [id], onDelete: Cascade)
  customerId       String
  customer         User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount           Int
  feeAmount        Int
  feePercent       Int           @default(18)
  customerName     String
  customerEmail    String
  customerPhone    String?
  confirmationCode String        @unique @default(cuid())
  stripeSessionId  String?       @unique
  stripePaymentId  String?
  status           BookingStatus @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([confirmationCode])
}
